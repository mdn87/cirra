[Unit]
Description=Cirra read-only audit route on loopback (GET only, no credentials)
After=network.target

[Service]
Type=simple
User=cirra-audit-reader
Group=cirra-audit-reader
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/
ExecStart=/run/cirra-audit-runtime/bin/python -m cirra serve-audit-reads \
    --state-dir /run/cirra-audit-state \
    --port 8797
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
BindReadOnlyPaths=/srv/lugos/services/cirra/current/.venv:/run/cirra-audit-runtime
BindReadOnlyPaths=/srv/lugos/state/cirra:/run/cirra-audit-state
InaccessiblePaths=/srv/lugos
InaccessiblePaths=-/run/cirra-audit-state/audit-publication/history
InaccessiblePaths=-/run/cirra-audit-state/audit-waivers/history
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
