[Unit]
Description=Cirra review worker and independent checkout observer
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=matt
Group=matt
SupplementaryGroups=docker
Environment=HOME=/home/matt
Environment=PATH=/home/matt/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/srv/lugos/services/cirra/current
ExecStart=/srv/lugos/services/cirra/current/.venv/bin/python -m cirra worker --service-config /srv/lugos/services/cirra/config/service.yaml --env-file /srv/lugos/services/cirra/config/worker.env --state-dir /srv/lugos/state/cirra
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The worker parses attacker-supplied PR data and is in the docker group, so it
# sees an empty home: only the Claude login (read-write) and CLI (read-only).
ProtectHome=tmpfs
BindPaths=-/home/matt/.claude -/home/matt/.claude.json
BindReadOnlyPaths=/home/matt/.local/bin -/home/matt/.local/lib/node_modules/@anthropic-ai
ReadWritePaths=/srv/lugos/state/cirra
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1536M
TasksMax=128

[Install]
WantedBy=multi-user.target
