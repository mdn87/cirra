[Unit]
Description=Cirra review worker and independent checkout observer
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=matt
Group=matt
SupplementaryGroups=docker
Environment=HOME=/home/matt
Environment=PATH=/home/matt/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/srv/lugos/services/cirra/current
LoadCredentialEncrypted=glas-bws-token:/etc/credstore.encrypted/glas-lugos-host-runtime
ExecStart=/usr/bin/python3 /srv/lugos/runtimes/glas/host-runtime.py /srv/lugos/runtimes/glas/config/cirra-worker.json
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The worker parses attacker-supplied PR data and is in the docker group, so it
# sees an empty home: only the Claude login (read-write) and CLI (read-only).
ProtectHome=tmpfs
BindPaths=-/home/matt/.claude -/home/matt/.claude.json
BindReadOnlyPaths=/home/matt/.local/bin -/home/matt/.local/lib/node_modules/@anthropic-ai
ReadWritePaths=/srv/lugos/state/cirra /srv/lugos/state/glas/cirra-worker
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1536M
TasksMax=128

[Install]
WantedBy=multi-user.target
