[Unit]
Description=Back up Cirra state and verify an isolated restore
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=4h
StartLimitBurst=5

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/lugos/restic-lugos-host.env
EnvironmentFile=/etc/cirra-state-backup.conf
ExecStart=/usr/bin/python3 -I /usr/local/libexec/cirra-backup-state.py backup
ExecStopPost=/usr/bin/python3 -I /usr/local/libexec/cirra-backup-state.py resume
StateDirectory=cirra-recovery
StateDirectoryMode=0700
TemporaryFileSystem=/run/cirra-recovery-restore:rw,nosuid,nodev,noexec,noswap,size=1G,mode=0700
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
TimeoutStartSec=20min
TimeoutStopSec=5min
Restart=on-failure
RestartSec=15min
