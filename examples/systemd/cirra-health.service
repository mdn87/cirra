[Unit]
Description=Cirra worker, queue, reconcile and budget health check
# Route failures to your alerting, for example a unit that posts to an
# operator-attention endpoint:
# OnFailure=cirra-health-alert.service

[Service]
Type=oneshot
User=matt
Group=matt
WorkingDirectory=/srv/lugos/services/cirra/current
ExecStart=/srv/lugos/services/cirra/current/.venv/bin/python -m cirra health --state-dir /srv/lugos/state/cirra
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/lugos/state/cirra
RestrictAddressFamilies=AF_UNIX
