[Unit]
Description=Cirra authenticated webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matt
Group=matt
WorkingDirectory=/srv/lugos/services/cirra/current
LoadCredentialEncrypted=glas-bws-token:/etc/credstore.encrypted/glas-lugos-host-runtime
ExecStart=/usr/bin/python3 /srv/lugos/runtimes/glas/host-runtime.py /srv/lugos/runtimes/glas/config/cirra-webhook.json
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lugos/state/cirra /srv/lugos/state/glas/cirra-webhook
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
