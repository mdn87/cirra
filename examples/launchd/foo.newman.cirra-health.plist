<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>foo.newman.cirra-health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/matt/.local/share/cirra-standby/ha-current/.venv/bin/python</string>
        <string>-I</string><string>-B</string>
        <string>/Users/matt/.local/share/cirra-standby/ha-current/scripts/report-health.py</string>
        <string>--state-dir</string><string>/Users/matt/.local/share/cirra-standby/state/current</string>
        <string>--service-config</string><string>/Users/matt/.local/share/cirra-standby/config/ha/service.yaml</string>
